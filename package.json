{
  "name": "movie-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "gen-types": "npx swagger-typescript-api -p http://localhost:3000/api-doc/json -o ./src/common/types -n api-types.ts -r --axios --extract-enums --enum-names-as-values",
    "gen-types-test": "npx swagger-typescript-api -p https://petstore.swagger.io/v2/swagger.json -o ./src/common/types -n api-types-test.ts -r --axios",
    "dev": "next dev -p 3001",
    "prevdev": "npm run gen-types",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "axios": "^1.7.7",
    "lucide-react": "^0.447.0",
    "next": "14.2.14",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.53.0",
    "react-player": "^2.16.0",
    "react-type-animation": "^3.2.0",
    "swagger-typescript-api": "^13.0.22",
    "tailwind-merge": "^2.6.0",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.14",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
